{
  "manifest_version": 3,
  "name": "SubToVoice",
  "description": "Read YouTube subtitles aloud as natural buffered speech without dropping lines.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "SubToVoice",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/subtitle-buffer.js",
        "src/speech-controller.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
